# Copy to .env for local development: cp .env.example .env
# Values below match docker-compose.yml. Never commit real secrets.

APP_URL=http://localhost:3000

# PostgreSQL (docker compose service "postgres"). Three roles, least privilege first:
# - DATABASE_URL: the app's role. No BYPASSRLS, so Row-Level Security isolates tenants.
# - DATABASE_AUTH_URL: Better Auth only. Reaches users, sessions, accounts and TOTP secrets, nothing else.
# - DATABASE_SYSTEM_URL: platform-admin and background jobs that span tenants (BYPASSRLS, audited).
# - DATABASE_ADMIN_URL: schema owner, used only by migrations (`pnpm db:migrate`).
# Local roles are created by `pnpm db:setup` (scripts/db/dev-roles.sql).
DATABASE_URL=postgresql://mustamir_app:mustamir_app@localhost:5432/mustamir
DATABASE_AUTH_URL=postgresql://mustamir_auth:mustamir_auth@localhost:5432/mustamir
DATABASE_SYSTEM_URL=postgresql://mustamir_system:mustamir_system@localhost:5432/mustamir
DATABASE_ADMIN_URL=postgresql://mustamir:mustamir@localhost:5432/mustamir

# Authentication (Better Auth). Signs session cookies and encrypts TOTP secrets.
# At least 32 characters; generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# S3-compatible object storage for evidence files (docker compose service "seaweedfs")
S3_ENDPOINT=http://localhost:8333
S3_REGION=me-central-1
S3_BUCKET=evidence
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
# Optional. The store's address as browsers see it, used to sign download links. Leave unset
# locally (S3_ENDPOINT is reachable from the browser). Deployed: https://files.<your host>.
# S3_PUBLIC_ENDPOINT=
# "s3" stores files at S3_ENDPOINT. "memory" keeps them in process (integration tests only).
STORAGE_DRIVER=s3

# Outgoing email (docker compose service "mailpit"). Inbox UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Mustamir <no-reply@mustamir.local>"
# Optional. Set both for a relay that needs a login (a hosted email provider). Mailpit needs none.
# SMTP_USER=
# SMTP_PASSWORD=
# "smtp" sends through SMTP_HOST. "memory" keeps messages in process (integration tests only).
EMAIL_TRANSPORT=smtp
