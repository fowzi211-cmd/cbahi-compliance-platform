# Copy to .env.local for local development: cp .env.example .env.local
# Values below match docker-compose.yml. Never commit real secrets.

APP_URL=http://localhost:3000

# PostgreSQL (docker compose service "postgres")
DATABASE_URL=postgresql://mustamir:mustamir@localhost:5432/mustamir

# S3-compatible object storage for evidence files (docker compose service "seaweedfs")
S3_ENDPOINT=http://localhost:8333
S3_REGION=me-central-1
S3_BUCKET=evidence
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key

# Outgoing email (docker compose service "mailpit"). Inbox UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Mustamir <no-reply@mustamir.local>"
