// Data model: docs/ARCHITECTURE.md §3. Every tenant-owned table carries `tenant_id` and has a
// Row-Level Security policy (added in the migration SQL, since Prisma cannot express it).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  platform
  hybrid
}

enum MembershipRole {
  facility_owner
  quality_manager
  department_head
  staff
  viewer
}

model Tenant {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  defaultLocale String   @default("ar") @map("default_locale")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription         Subscription?
  facilities           Facility[]
  departments          Department[]
  memberships          Membership[]
  invitations          Invitation[]
  auditEvents          AuditEvent[]
  facilityFrameworks   FacilityFramework[]
  elementApplicability ElementApplicability[]
  surveyCycles         SurveyCycle[]

  @@map("tenant")
}

model Subscription {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @unique @map("tenant_id") @db.Uuid
  tier             Tier      @default(platform)
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  featureOverrides Json      @default("{}") @map("feature_overrides")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

model Facility {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  nameAr     String    @map("name_ar")
  nameEn     String    @map("name_en")
  // A code from the facility_type catalogue. It decides which frameworks are suggested and
  // which elements apply (Element.facilityTypes).
  type       String
  licenseNo  String?   @map("license_no")
  city       String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  // Onboarding wizard progress (M5): the steps saved so far, and when it was finished.
  onboardingSteps String[]  @default([]) @map("onboarding_steps")
  onboardedAt     DateTime? @map("onboarded_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facilityType  FacilityType           @relation(fields: [type], references: [code])
  departments   Department[]
  memberships   Membership[]
  invitations   Invitation[]
  frameworks    FacilityFramework[]
  applicability ElementApplicability[]
  surveyCycle   SurveyCycle?

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("facility")
}

model Department {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  facilityId String    @map("facility_id") @db.Uuid
  nameAr     String    @map("name_ar")
  nameEn     String    @map("name_en")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // What kind of department this is, so elements tagged with a department type find it.
  typeCode    String?         @map("department_type")
  // Composite key: a department can never point at another tenant's facility.
  facility    Facility        @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  type        DepartmentType? @relation(fields: [typeCode], references: [code])
  memberships Membership[]
  invitations Invitation[]

  @@unique([tenantId, id])
  @@index([tenantId, facilityId])
  @@map("department")
}

// Users are global: one person can hold roles in several tenants (e.g. a quality manager
// working for two clinic groups). What they can see is decided by Membership.
// The email/name/emailVerified/image/twoFactorEnabled fields are the shape Better Auth expects.
model User {
  id                   String    @id @default(uuid(7)) @db.Uuid
  email                String    @unique
  name                 String
  emailVerified        Boolean   @default(false) @map("email_verified")
  image                String?
  locale               String    @default("ar")
  isPlatformAdmin      Boolean   @default(false) @map("is_platform_admin")
  isPlatformConsultant Boolean   @default(false) @map("is_platform_consultant")
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  // Password lockout (docs/ARCHITECTURE.md §6). The second factor has its own counter on TwoFactor.
  failedLoginCount     Int       @default(0) @map("failed_login_count")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]

  @@map("app_user")
}

// Better Auth tables. Only the `mustamir_auth` database role can read them: the app role
// never sees password hashes, session tokens or TOTP secrets.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verification")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  // Encrypted by Better Auth with BETTER_AUTH_SECRET.
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("auth_two_factor")
}

model Membership {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  facilityId   String         @map("facility_id") @db.Uuid
  departmentId String?        @map("department_id") @db.Uuid
  role         MembershipRole
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility    @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([userId, facilityId, role])
  @@index([tenantId, facilityId])
  @@map("membership")
}

// An invitation into one facility role. Only a SHA-256 hash of the token is stored, so a
// database leak cannot be turned into working invitation links.
model Invitation {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  facilityId   String         @map("facility_id") @db.Uuid
  departmentId String?        @map("department_id") @db.Uuid
  email        String
  role         MembershipRole
  locale       String         @default("ar")
  tokenHash    Bytes          @unique @map("token_hash")
  invitedBy    String?        @map("invited_by") @db.Uuid
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime?      @map("accepted_at") @db.Timestamptz(6)
  acceptedBy   String?        @map("accepted_by") @db.Uuid
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility   Facility    @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, facilityId])
  @@map("invitation")
}

// Append-only. A database trigger rejects UPDATE and DELETE, stamps `at` with the server
// clock and chains each row to the previous one of the same tenant with SHA-256.
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?  @map("tenant_id") @db.Uuid
  chainSeq    BigInt   @default(0) @map("chain_seq")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?  @db.Inet
  at          DateTime @default(now()) @db.Timestamptz(6)
  prevHash    Bytes?   @map("prev_hash")
  hash        Bytes?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, at])
  @@index([tenantId, entity, entityId])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Standards library (docs/ARCHITECTURE.md §3.1). Global, not tenant-owned: every tenant
// reads the same published editions, and only the platform admin writes them (through the
// system connection, audited). The app role sees active and retired editions only; drafts
// stay hidden because their licence has not been confirmed yet (RLS in the migration).
// Real frameworks arrive only through the importer at runtime; the repo seeds DEMO-* text.
// ---------------------------------------------------------------------------

enum FrameworkStatus {
  draft
  active
  retired
}

enum FrameworkImportStatus {
  validated
  committed
  discarded
}

// One row per edition. A new edition of the same framework is a new row with the same
// code, so assessments made against an older edition keep pointing at the text they used.
model Framework {
  id           String          @id @default(uuid(7)) @db.Uuid
  code         String
  edition      String
  nameAr       String?         @map("name_ar")
  nameEn       String?         @map("name_en")
  program      String
  status       FrameworkStatus @default(draft)
  rollupConfig Json            @map("rollup_config")
  // Who licensed the text and on what terms. Required before an edition can go live.
  licenseNote  String?         @map("license_note")
  activatedAt  DateTime?       @map("activated_at") @db.Timestamptz(6)
  retiredAt    DateTime?       @map("retired_at") @db.Timestamptz(6)
  createdBy    String?         @map("created_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  scoreLevels ScoreLevel[]
  chapters    Chapter[]
  standards   Standard[]
  elements    Element[]
  imports     FrameworkImport[]
  facilities  FacilityFramework[]

  @@unique([code, edition])
  @@map("framework")
}

// The scoring scale belongs to the edition: a later edition may change the levels without
// rewriting how older assessments were scored.
model ScoreLevel {
  id                  String  @id @default(uuid(7)) @db.Uuid
  frameworkId         String  @map("framework_id") @db.Uuid
  code                String
  labelAr             String? @map("label_ar")
  labelEn             String? @map("label_en")
  value               Decimal @db.Decimal(4, 3)
  countsInDenominator Boolean @map("counts_in_denominator")
  requiresEvidence    Boolean @map("requires_evidence")
  generatesFinding    Boolean @map("generates_finding")
  sort                Int

  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, code])
  @@map("score_level")
}

model Chapter {
  id          String  @id @default(uuid(7)) @db.Uuid
  frameworkId String  @map("framework_id") @db.Uuid
  code        String
  titleAr     String? @map("title_ar")
  titleEn     String? @map("title_en")
  sort        Int

  framework Framework  @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  standards Standard[]

  @@unique([frameworkId, code])
  @@unique([frameworkId, id])
  @@map("chapter")
}

model Standard {
  id          String  @id @default(uuid(7)) @db.Uuid
  frameworkId String  @map("framework_id") @db.Uuid
  chapterId   String  @map("chapter_id") @db.Uuid
  code        String
  titleAr     String? @map("title_ar")
  titleEn     String? @map("title_en")
  weight      Decimal @default(1) @db.Decimal(8, 3)
  sort        Int

  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  // Composite key: a standard can only sit in a chapter of its own edition.
  chapter   Chapter   @relation(fields: [frameworkId, chapterId], references: [frameworkId, id], onDelete: Cascade)
  elements  Element[]

  @@unique([frameworkId, code])
  @@unique([frameworkId, id])
  @@index([chapterId])
  @@map("standard")
}

model Element {
  id              String   @id @default(uuid(7)) @db.Uuid
  frameworkId     String   @map("framework_id") @db.Uuid
  standardId      String   @map("standard_id") @db.Uuid
  code            String
  titleAr         String?  @map("title_ar")
  titleEn         String?  @map("title_en")
  descriptionAr   String?  @map("description_ar")
  descriptionEn   String?  @map("description_en")
  isEsr           Boolean  @default(false) @map("is_esr")
  weight          Decimal  @default(1) @db.Decimal(8, 3)
  sort            Int
  // Codes from the evidence-type list (domain/import-schema.ts) and the facility- and
  // department-type catalogues. An empty facility list means "every facility type"; an
  // empty department list means the element is facility-wide.
  evidenceTypes   String[] @map("evidence_types")
  facilityTypes   String[] @map("facility_types")
  departmentTypes String[] @map("department_types")

  framework     Framework              @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  standard      Standard               @relation(fields: [frameworkId, standardId], references: [frameworkId, id], onDelete: Cascade)
  applicability ElementApplicability[]

  @@unique([frameworkId, code])
  @@index([standardId])
  @@map("element")
}

// Catalogues the importer validates applicability codes against. Generic labels only.
model FacilityType {
  code   String @id
  nameAr String @map("name_ar")
  nameEn String @map("name_en")
  sort   Int

  facilities Facility[]

  @@map("facility_type")
}

model DepartmentType {
  code   String @id
  nameAr String @map("name_ar")
  nameEn String @map("name_en")
  sort   Int

  departments Department[]

  @@map("department_type")
}

// An uploaded file that passed validation, kept between preview and commit. Files with
// errors are never stored. The normalized document is what gets committed, so the admin
// commits exactly what they previewed.
model FrameworkImport {
  id          String                @id @default(uuid(7)) @db.Uuid
  status      FrameworkImportStatus @default(validated)
  fileName    String                @map("file_name")
  fileSha256  Bytes                 @map("file_sha256")
  format      String
  document    Json
  report      Json
  frameworkId String?               @map("framework_id") @db.Uuid
  createdBy   String                @map("created_by") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  committedAt DateTime?             @map("committed_at") @db.Timestamptz(6)

  framework Framework? @relation(fields: [frameworkId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("framework_import")
}

// ---------------------------------------------------------------------------
// What applies to a facility (M5). Tenant-owned, so each table has tenant_id, a composite
// foreign key to its facility and an RLS policy (migration SQL).
// ---------------------------------------------------------------------------

// The framework editions a facility is assessed against.
model FacilityFramework {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  facilityId  String   @map("facility_id") @db.Uuid
  frameworkId String   @map("framework_id") @db.Uuid
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility  Facility  @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Restrict)

  @@unique([facilityId, frameworkId])
  @@index([tenantId, facilityId])
  @@map("facility_framework")
}

// A facility's own decision that an element does (or does not) apply, overriding the
// framework's facility-type rule. "Not applicable" needs a justification: a surveyor will
// ask why.
model ElementApplicability {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  facilityId    String   @map("facility_id") @db.Uuid
  elementId     String   @map("element_id") @db.Uuid
  applicable    Boolean
  justification String?
  decidedBy     String?  @map("decided_by") @db.Uuid
  decidedAt     DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  element  Element  @relation(fields: [elementId], references: [id], onDelete: Restrict)

  @@unique([facilityId, elementId])
  @@index([tenantId, facilityId])
  @@map("element_applicability")
}

enum AccreditationStatus {
  never_surveyed
  accredited
  conditional
  not_accredited
  expired
}

// Where the facility stands in its accreditation cycle. One current row per facility.
model SurveyCycle {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  facilityId     String              @unique @map("facility_id") @db.Uuid
  status         AccreditationStatus @default(never_surveyed)
  lastSurveyOn   DateTime?           @map("last_survey_on") @db.Date
  nextExpectedOn DateTime?           @map("next_expected_on") @db.Date
  notes          String?
  updatedBy      String?             @map("updated_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, facilityId])
  @@map("survey_cycle")
}
