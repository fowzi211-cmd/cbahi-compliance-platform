// Data model: docs/ARCHITECTURE.md §3. Every tenant-owned table carries `tenant_id` and has a
// Row-Level Security policy (added in the migration SQL, since Prisma cannot express it).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  platform
  hybrid
}

enum MembershipRole {
  facility_owner
  quality_manager
  department_head
  staff
  viewer
}

model Tenant {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  defaultLocale String   @default("ar") @map("default_locale")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription         Subscription?
  facilities           Facility[]
  departments          Department[]
  memberships          Membership[]
  invitations          Invitation[]
  auditEvents          AuditEvent[]
  facilityFrameworks   FacilityFramework[]
  elementApplicability ElementApplicability[]
  surveyCycles         SurveyCycle[]
  assessments          Assessment[]
  elementScores        ElementScore[]
  scoreEvidence        ScoreEvidence[]
  elementStatuses      ElementStatus[]
  findings             Finding[]
  documents            Document[]
  documentVersions     DocumentVersion[]
  documentApprovals    DocumentApproval[]
  documentElements     DocumentElement[]
  capaItems            CapaItem[]
  capaEvidence         CapaEvidence[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]

  @@map("tenant")
}

model Subscription {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @unique @map("tenant_id") @db.Uuid
  tier             Tier      @default(platform)
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  featureOverrides Json      @default("{}") @map("feature_overrides")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

model Facility {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  nameAr     String    @map("name_ar")
  nameEn     String    @map("name_en")
  // A code from the facility_type catalogue. It decides which frameworks are suggested and
  // which elements apply (Element.facilityTypes).
  type       String
  licenseNo  String?   @map("license_no")
  city       String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  // Onboarding wizard progress (M5): the steps saved so far, and when it was finished.
  onboardingSteps String[]  @default([]) @map("onboarding_steps")
  onboardedAt     DateTime? @map("onboarded_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facilityType  FacilityType           @relation(fields: [type], references: [code])
  departments   Department[]
  memberships   Membership[]
  invitations   Invitation[]
  frameworks    FacilityFramework[]
  applicability ElementApplicability[]
  surveyCycle   SurveyCycle?
  assessments   Assessment[]
  statuses      ElementStatus[]
  findings      Finding[]
  documents     Document[]
  capaItems     CapaItem[]
  notifications Notification[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("facility")
}

model Department {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  facilityId String    @map("facility_id") @db.Uuid
  nameAr     String    @map("name_ar")
  nameEn     String    @map("name_en")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // What kind of department this is, so elements tagged with a department type find it.
  typeCode    String?         @map("department_type")
  // Composite key: a department can never point at another tenant's facility.
  facility    Facility        @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  type        DepartmentType? @relation(fields: [typeCode], references: [code])
  memberships Membership[]
  invitations Invitation[]
  assessments Assessment[]
  documents   Document[]

  @@unique([tenantId, id])
  @@index([tenantId, facilityId])
  @@map("department")
}

// Users are global: one person can hold roles in several tenants (e.g. a quality manager
// working for two clinic groups). What they can see is decided by Membership.
// The email/name/emailVerified/image/twoFactorEnabled fields are the shape Better Auth expects.
model User {
  id                   String    @id @default(uuid(7)) @db.Uuid
  email                String    @unique
  name                 String
  emailVerified        Boolean   @default(false) @map("email_verified")
  image                String?
  locale               String    @default("ar")
  isPlatformAdmin      Boolean   @default(false) @map("is_platform_admin")
  isPlatformConsultant Boolean   @default(false) @map("is_platform_consultant")
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  // Password lockout (docs/ARCHITECTURE.md §6). The second factor has its own counter on TwoFactor.
  failedLoginCount     Int       @default(0) @map("failed_login_count")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]

  @@map("app_user")
}

// Better Auth tables. Only the `mustamir_auth` database role can read them: the app role
// never sees password hashes, session tokens or TOTP secrets.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verification")
}

model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  // Encrypted by Better Auth with BETTER_AUTH_SECRET.
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("auth_two_factor")
}

model Membership {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  facilityId   String         @map("facility_id") @db.Uuid
  departmentId String?        @map("department_id") @db.Uuid
  role         MembershipRole
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility    @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([userId, facilityId, role])
  @@index([tenantId, facilityId])
  @@map("membership")
}

// An invitation into one facility role. Only a SHA-256 hash of the token is stored, so a
// database leak cannot be turned into working invitation links.
model Invitation {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  facilityId   String         @map("facility_id") @db.Uuid
  departmentId String?        @map("department_id") @db.Uuid
  email        String
  role         MembershipRole
  locale       String         @default("ar")
  tokenHash    Bytes          @unique @map("token_hash")
  invitedBy    String?        @map("invited_by") @db.Uuid
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime?      @map("accepted_at") @db.Timestamptz(6)
  acceptedBy   String?        @map("accepted_by") @db.Uuid
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility   Facility    @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, facilityId])
  @@map("invitation")
}

// Append-only. A database trigger rejects UPDATE and DELETE, stamps `at` with the server
// clock and chains each row to the previous one of the same tenant with SHA-256.
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?  @map("tenant_id") @db.Uuid
  chainSeq    BigInt   @default(0) @map("chain_seq")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?  @db.Inet
  at          DateTime @default(now()) @db.Timestamptz(6)
  prevHash    Bytes?   @map("prev_hash")
  hash        Bytes?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, at])
  @@index([tenantId, entity, entityId])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Standards library (docs/ARCHITECTURE.md §3.1). Global, not tenant-owned: every tenant
// reads the same published editions, and only the platform admin writes them (through the
// system connection, audited). The app role sees active and retired editions only; drafts
// stay hidden because their licence has not been confirmed yet (RLS in the migration).
// Real frameworks arrive only through the importer at runtime; the repo seeds DEMO-* text.
// ---------------------------------------------------------------------------

enum FrameworkStatus {
  draft
  active
  retired
}

enum FrameworkImportStatus {
  validated
  committed
  discarded
}

// One row per edition. A new edition of the same framework is a new row with the same
// code, so assessments made against an older edition keep pointing at the text they used.
model Framework {
  id           String          @id @default(uuid(7)) @db.Uuid
  code         String
  edition      String
  nameAr       String?         @map("name_ar")
  nameEn       String?         @map("name_en")
  program      String
  status       FrameworkStatus @default(draft)
  rollupConfig Json            @map("rollup_config")
  // Who licensed the text and on what terms. Required before an edition can go live.
  licenseNote  String?         @map("license_note")
  activatedAt  DateTime?       @map("activated_at") @db.Timestamptz(6)
  retiredAt    DateTime?       @map("retired_at") @db.Timestamptz(6)
  createdBy    String?         @map("created_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  scoreLevels ScoreLevel[]
  chapters    Chapter[]
  standards   Standard[]
  elements    Element[]
  imports     FrameworkImport[]
  facilities  FacilityFramework[]
  assessments Assessment[]

  @@unique([code, edition])
  @@map("framework")
}

// The scoring scale belongs to the edition: a later edition may change the levels without
// rewriting how older assessments were scored.
model ScoreLevel {
  id                  String  @id @default(uuid(7)) @db.Uuid
  frameworkId         String  @map("framework_id") @db.Uuid
  code                String
  labelAr             String? @map("label_ar")
  labelEn             String? @map("label_en")
  value               Decimal @db.Decimal(4, 3)
  countsInDenominator Boolean @map("counts_in_denominator")
  requiresEvidence    Boolean @map("requires_evidence")
  generatesFinding    Boolean @map("generates_finding")
  sort                Int

  framework Framework      @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  scores    ElementScore[]

  @@unique([frameworkId, code])
  @@map("score_level")
}

model Chapter {
  id          String  @id @default(uuid(7)) @db.Uuid
  frameworkId String  @map("framework_id") @db.Uuid
  code        String
  titleAr     String? @map("title_ar")
  titleEn     String? @map("title_en")
  sort        Int

  framework Framework  @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  standards Standard[]

  @@unique([frameworkId, code])
  @@unique([frameworkId, id])
  @@map("chapter")
}

model Standard {
  id          String  @id @default(uuid(7)) @db.Uuid
  frameworkId String  @map("framework_id") @db.Uuid
  chapterId   String  @map("chapter_id") @db.Uuid
  code        String
  titleAr     String? @map("title_ar")
  titleEn     String? @map("title_en")
  weight      Decimal @default(1) @db.Decimal(8, 3)
  sort        Int

  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  // Composite key: a standard can only sit in a chapter of its own edition.
  chapter   Chapter   @relation(fields: [frameworkId, chapterId], references: [frameworkId, id], onDelete: Cascade)
  elements  Element[]

  @@unique([frameworkId, code])
  @@unique([frameworkId, id])
  @@index([chapterId])
  @@map("standard")
}

model Element {
  id              String   @id @default(uuid(7)) @db.Uuid
  frameworkId     String   @map("framework_id") @db.Uuid
  standardId      String   @map("standard_id") @db.Uuid
  code            String
  titleAr         String?  @map("title_ar")
  titleEn         String?  @map("title_en")
  descriptionAr   String?  @map("description_ar")
  descriptionEn   String?  @map("description_en")
  isEsr           Boolean  @default(false) @map("is_esr")
  weight          Decimal  @default(1) @db.Decimal(8, 3)
  sort            Int
  // Codes from the evidence-type list (domain/import-schema.ts) and the facility- and
  // department-type catalogues. An empty facility list means "every facility type"; an
  // empty department list means the element is facility-wide.
  evidenceTypes   String[] @map("evidence_types")
  facilityTypes   String[] @map("facility_types")
  departmentTypes String[] @map("department_types")

  framework     Framework              @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  standard      Standard               @relation(fields: [frameworkId, standardId], references: [frameworkId, id], onDelete: Cascade)
  applicability ElementApplicability[]
  scores        ElementScore[]
  statuses      ElementStatus[]
  findings      Finding[]
  documents     DocumentElement[]

  @@unique([frameworkId, code])
  @@index([standardId])
  @@map("element")
}

// Catalogues the importer validates applicability codes against. Generic labels only.
model FacilityType {
  code   String @id
  nameAr String @map("name_ar")
  nameEn String @map("name_en")
  sort   Int

  facilities Facility[]

  @@map("facility_type")
}

model DepartmentType {
  code   String @id
  nameAr String @map("name_ar")
  nameEn String @map("name_en")
  sort   Int

  departments Department[]

  @@map("department_type")
}

// An uploaded file that passed validation, kept between preview and commit. Files with
// errors are never stored. The normalized document is what gets committed, so the admin
// commits exactly what they previewed.
model FrameworkImport {
  id          String                @id @default(uuid(7)) @db.Uuid
  status      FrameworkImportStatus @default(validated)
  fileName    String                @map("file_name")
  fileSha256  Bytes                 @map("file_sha256")
  format      String
  document    Json
  report      Json
  frameworkId String?               @map("framework_id") @db.Uuid
  createdBy   String                @map("created_by") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  committedAt DateTime?             @map("committed_at") @db.Timestamptz(6)

  framework Framework? @relation(fields: [frameworkId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("framework_import")
}

// ---------------------------------------------------------------------------
// What applies to a facility (M5). Tenant-owned, so each table has tenant_id, a composite
// foreign key to its facility and an RLS policy (migration SQL).
// ---------------------------------------------------------------------------

// The framework editions a facility is assessed against.
model FacilityFramework {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  facilityId  String   @map("facility_id") @db.Uuid
  frameworkId String   @map("framework_id") @db.Uuid
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility  Facility  @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Restrict)

  @@unique([facilityId, frameworkId])
  @@index([tenantId, facilityId])
  @@map("facility_framework")
}

// A facility's own decision that an element does (or does not) apply, overriding the
// framework's facility-type rule. "Not applicable" needs a justification: a surveyor will
// ask why.
model ElementApplicability {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  facilityId    String   @map("facility_id") @db.Uuid
  elementId     String   @map("element_id") @db.Uuid
  applicable    Boolean
  justification String?
  decidedBy     String?  @map("decided_by") @db.Uuid
  decidedAt     DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  element  Element  @relation(fields: [elementId], references: [id], onDelete: Restrict)

  @@unique([facilityId, elementId])
  @@index([tenantId, facilityId])
  @@map("element_applicability")
}

enum AccreditationStatus {
  never_surveyed
  accredited
  conditional
  not_accredited
  expired
}

// Where the facility stands in its accreditation cycle. One current row per facility.
model SurveyCycle {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  facilityId     String              @unique @map("facility_id") @db.Uuid
  status         AccreditationStatus @default(never_surveyed)
  lastSurveyOn   DateTime?           @map("last_survey_on") @db.Date
  nextExpectedOn DateTime?           @map("next_expected_on") @db.Date
  notes          String?
  updatedBy      String?             @map("updated_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, facilityId])
  @@map("survey_cycle")
}

// ---------------------------------------------------------------------------
// Self-assessment (M7). Tenant-owned: tenant_id, composite foreign keys and RLS (migration
// SQL). Once an assessment is submitted, a trigger refuses any change to it, its scores or
// its evidence: a submitted assessment is a record a surveyor may ask to see.
// ---------------------------------------------------------------------------

enum AssessmentKind {
  self
  tracer
  mock_survey
}

enum ScoreSource {
  internal
  consultant
}

enum AssessmentStatus {
  in_progress
  submitted
}

model Assessment {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  facilityId   String           @map("facility_id") @db.Uuid
  frameworkId  String           @map("framework_id") @db.Uuid
  // Null for a whole-facility assessment.
  departmentId String?          @map("department_id") @db.Uuid
  kind         AssessmentKind   @default(self)
  source       ScoreSource      @default(internal)
  status       AssessmentStatus @default(in_progress)
  startedBy    String?          @map("started_by") @db.Uuid
  startedAt    DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedBy  String?          @map("submitted_by") @db.Uuid
  submittedAt  DateTime?        @map("submitted_at") @db.Timestamptz(6)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility   Facility       @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  department Department?    @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  framework  Framework      @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  scores     ElementScore[]
  findings   Finding[]

  @@unique([tenantId, id])
  @@index([tenantId, facilityId, startedAt])
  @@map("assessment")
}

model ElementScore {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  elementId    String   @map("element_id") @db.Uuid
  scoreLevelId String   @map("score_level_id") @db.Uuid
  comment      String?
  scoredBy     String?  @map("scored_by") @db.Uuid
  // Server time, set on every save: expiry runs from here and cannot be backdated.
  scoredAt     DateTime @map("scored_at") @db.Timestamptz(6)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessment Assessment      @relation(fields: [tenantId, assessmentId], references: [tenantId, id], onDelete: Cascade)
  element    Element         @relation(fields: [elementId], references: [id], onDelete: Restrict)
  level      ScoreLevel      @relation(fields: [scoreLevelId], references: [id], onDelete: Restrict)
  evidence   ScoreEvidence[]
  finding    Finding?        @relation("FindingSource")
  verified   Finding[]       @relation("FindingVerification")
  statuses   ElementStatus[]

  @@unique([assessmentId, elementId])
  @@unique([tenantId, id])
  @@index([tenantId, assessmentId])
  @@map("element_score")
}

enum EvidenceKind {
  document
  observation
  interview
  record_review
  kpi
}

// What backs a score. Until the document library (M8) a "document" is a link; the other
// kinds are notes of what was seen, heard or counted. Never patient-identifiable.
model ScoreEvidence {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  elementScoreId    String       @map("element_score_id") @db.Uuid
  kind              EvidenceKind
  note              String?
  url               String?
  // An approved version from the document library (M8); `url` stays for links cited before.
  documentVersionId String?      @map("document_version_id") @db.Uuid
  createdBy         String?      @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  elementScore    ElementScore     @relation(fields: [tenantId, elementScoreId], references: [tenantId, id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [tenantId, documentVersionId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, elementScoreId])
  @@map("score_evidence")
}

// The current verified state of each element, one series per source (decision 7).
model ElementStatus {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  facilityId     String      @map("facility_id") @db.Uuid
  elementId      String      @map("element_id") @db.Uuid
  source         ScoreSource
  elementScoreId String      @map("element_score_id") @db.Uuid
  levelCode      String      @map("level_code")
  verifiedAt     DateTime    @map("verified_at") @db.Timestamptz(6)
  expiresAt      DateTime?   @map("expires_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility     Facility     @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  element      Element      @relation(fields: [elementId], references: [id], onDelete: Restrict)
  elementScore ElementScore @relation(fields: [tenantId, elementScoreId], references: [tenantId, id], onDelete: Restrict)

  @@unique([facilityId, elementId, source])
  @@index([tenantId, facilityId])
  @@map("element_status")
}

enum FindingSeverity {
  esr
  high
  medium
  low
}

enum FindingStatus {
  open
  in_progress
  closed
  verified
}

// A gap raised automatically from a submitted score whose level generates findings (rule 6).
// CAPA items hang off it from M9.
model Finding {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  facilityId      String          @map("facility_id") @db.Uuid
  assessmentId    String          @map("assessment_id") @db.Uuid
  elementScoreId  String          @map("element_score_id") @db.Uuid
  elementId       String          @map("element_id") @db.Uuid
  departmentId    String?         @map("department_id") @db.Uuid
  levelCode       String          @map("level_code")
  severity        FindingSeverity
  status          FindingStatus   @default(open)
  // The scorer's comment at the time, in the language it was written in.
  statement       String?
  // When every corrective action was done (M9), and the later full-compliance score that
  // proved the fix held (rule 7).
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz(6)
  verifiedAt      DateTime?       @map("verified_at") @db.Timestamptz(6)
  verifiedScoreId String?         @map("verified_score_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility      Facility      @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  assessment    Assessment    @relation(fields: [tenantId, assessmentId], references: [tenantId, id], onDelete: Cascade)
  elementScore  ElementScore  @relation("FindingSource", fields: [tenantId, elementScoreId], references: [tenantId, id], onDelete: Cascade)
  verifiedScore ElementScore? @relation("FindingVerification", fields: [tenantId, verifiedScoreId], references: [tenantId, id], onDelete: Restrict)
  element       Element       @relation(fields: [elementId], references: [id], onDelete: Restrict)
  capaItems     CapaItem[]

  @@unique([tenantId, elementScoreId])
  @@unique([tenantId, id])
  @@index([tenantId, facilityId, status])
  @@map("finding")
}

// ---------------------------------------------------------------------------
// Document control (M8). Tenant-owned: tenant_id, composite foreign keys and RLS. A
// version's file never changes once uploaded (trigger): a new file is a new version.
// ---------------------------------------------------------------------------

enum DocumentType {
  policy
  procedure
  form
  plan
  other
}

enum DocumentVersionStatus {
  in_review
  approved
  rejected
  superseded
}

enum ApprovalDecision {
  approved
  rejected
}

model Document {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  facilityId   String       @map("facility_id") @db.Uuid
  // The department that owns the document; null for facility-wide documents.
  departmentId String?      @map("department_id") @db.Uuid
  type         DocumentType
  titleAr      String?      @map("title_ar")
  titleEn      String?      @map("title_en")
  ownerUserId  String?      @map("owner_user_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  retiredAt    DateTime?    @map("retired_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility   Facility          @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  department Department?       @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  versions   DocumentVersion[]
  elements   DocumentElement[]

  @@unique([tenantId, id])
  @@index([tenantId, facilityId])
  @@map("document")
}

model DocumentVersion {
  id          String                @id @default(uuid(7)) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  documentId  String                @map("document_id") @db.Uuid
  version     Int
  status      DocumentVersionStatus @default(in_review)
  fileName    String                @map("file_name")
  contentType String                @map("content_type")
  bytes       Int
  sha256      Bytes
  storageKey  String                @map("storage_key")
  effectiveOn DateTime?             @map("effective_on") @db.Date
  reviewOn    DateTime?             @map("review_on") @db.Date
  expiresOn   DateTime?             @map("expires_on") @db.Date
  changeNote  String?               @map("change_note")
  // The uploader confirmed the file holds no patient data (always true: it is required).
  phiAttested Boolean               @map("phi_attested")
  // What the scan found, as counts per kind ({ scanned, hits: [{ kind, count }] }), never
  // the matched text.
  phiScan     Json                  @map("phi_scan")
  // The scan found something and the uploader confirmed it is redacted or not patient data.
  phiOverride Boolean               @default(false) @map("phi_override")
  uploadedBy  String?               @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime              @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document     Document           @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)
  approvals    DocumentApproval[]
  evidence     ScoreEvidence[]
  capaEvidence CapaEvidence[]

  @@unique([documentId, version])
  @@unique([tenantId, id])
  @@index([tenantId, documentId])
  @@map("document_version")
}

model DocumentApproval {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  versionId      String           @map("version_id") @db.Uuid
  approverUserId String?          @map("approver_user_id") @db.Uuid
  decision       ApprovalDecision
  comment        String?
  decidedAt      DateTime         @default(now()) @map("decided_at") @db.Timestamptz(6)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version DocumentVersion @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, versionId])
  @@map("document_approval")
}

// A document the facility relies on for an element ("this policy covers DEMO-MED.1.2").
model DocumentElement {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  elementId  String   @map("element_id") @db.Uuid
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)
  element  Element  @relation(fields: [elementId], references: [id], onDelete: Restrict)

  @@unique([documentId, elementId])
  @@index([tenantId, elementId])
  @@map("document_element")
}

// ---------------------------------------------------------------------------
// Corrective and preventive actions (M9). Tenant-owned: tenant_id, composite foreign keys
// and RLS. "Overdue" is not stored: it follows from due_on and the day (rule 7).
// ---------------------------------------------------------------------------

enum CapaStatus {
  open
  in_progress
  done
  cancelled
}

enum CapaEvidenceKind {
  document
  link
}

model CapaItem {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  facilityId   String     @map("facility_id") @db.Uuid
  findingId    String     @map("finding_id") @db.Uuid
  // Copied from the finding so department scoping needs no join.
  departmentId String?    @map("department_id") @db.Uuid
  // What will be done, in the language it was written in.
  action       String
  ownerUserId  String     @map("owner_user_id") @db.Uuid
  dueOn        DateTime   @map("due_on") @db.Date
  status       CapaStatus @default(open)
  closureNote  String?    @map("closure_note")
  closedAt     DateTime?  @map("closed_at") @db.Timestamptz(6)
  closedBy     String?    @map("closed_by") @db.Uuid
  createdBy    String?    @map("created_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility Facility       @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  finding  Finding        @relation(fields: [tenantId, findingId], references: [tenantId, id], onDelete: Cascade)
  evidence CapaEvidence[]

  @@unique([tenantId, id])
  @@index([tenantId, findingId])
  @@index([tenantId, facilityId, status, dueOn])
  @@index([tenantId, ownerUserId])
  @@map("capa_item")
}

// Proof that an action was done: an approved document version or a link.
model CapaEvidence {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  capaItemId        String           @map("capa_item_id") @db.Uuid
  kind              CapaEvidenceKind
  documentVersionId String?          @map("document_version_id") @db.Uuid
  url               String?
  description       String?
  addedBy           String?          @map("added_by") @db.Uuid
  addedAt           DateTime         @default(now()) @map("added_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capaItem        CapaItem         @relation(fields: [tenantId, capaItemId], references: [tenantId, id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [tenantId, documentVersionId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, capaItemId])
  @@map("capa_evidence")
}

// ---------------------------------------------------------------------------
// Notifications (M10). Tenant-owned with RLS. A notification is the in-app record and the
// email outbox at once: the worker sends what is pending and marks it, so nothing is lost
// if a job fails after the business change committed.
// ---------------------------------------------------------------------------

enum NotificationPriority {
  // Sent by email as soon as the worker sees it (an assignment, an escalation, an expiry).
  immediate
  // Collected into the daily digest (review due, expiring soon).
  digest
}

enum EmailStatus {
  pending
  sent
  // Nothing to send: email turned off, or read in the app before the digest went out.
  skipped
  failed
}

model Notification {
  id            String               @id @default(uuid(7)) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  facilityId    String               @map("facility_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  type          String
  // Template values (codes, titles, dates), never patient data or document contents.
  payload       Json
  priority      NotificationPriority
  // One notice per event and person: a daily job can run again without repeating itself.
  dedupeKey     String               @map("dedupe_key")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt        DateTime?            @map("read_at") @db.Timestamptz(6)
  emailStatus   EmailStatus          @default(pending) @map("email_status")
  emailedAt     DateTime?            @map("emailed_at") @db.Timestamptz(6)
  emailAttempts Int                  @default(0) @map("email_attempts")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, emailStatus])
  @@map("notification")
}

model NotificationPreference {
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  emailImmediate Boolean  @default(true) @map("email_immediate")
  emailDigest    Boolean  @default(true) @map("email_digest")
  // The language of emails; null means the language the person signed up in.
  locale         String?
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("notification_preference")
}
